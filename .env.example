# Configuración del Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8501
STREAMLIT_LOGGER_LEVEL=info

# Configuración de Datos
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
TEMPLATES_DIR=./data/templates
OUTPUTS_DIR=./outputs

# Umbrales de Gates (opcional - usa valores por defecto si no se define)
GATE_ICI_MINIMO=40
GATE_IOM_MINIMO=30
GATE_DIMENSION_CRITICA=25
GATE_POBREZA_ALTO_RIESGO=50

# Configuración de Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Configuración de Seguridad (si aplica)
ENABLE_AUTHENTICATION=false
SECRET_KEY=your-secret-key-here

# Configuración de Base de Datos (opcional para futuro)
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modelo_2_0
DB_USER=admin
DB_PASSWORD=password

# Configuración de Backup
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30

# Otras variables
ENVIRONMENT=development
DEBUG=true
TIMEZONE=America/Bogota
